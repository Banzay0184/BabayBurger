{
  "routes": [
    { "src": "/cashier.html", "dest": "/cashier.html" },
    { "src": "/operator.html", "dest": "/operator.html" },
    { "src": "/client.html", "dest": "/client.html" },
    { "src": "/cashier-manifest.json", "dest": "/cashier-manifest.json" },
    { "src": "/cashier-sw.js", "dest": "/cashier-sw.js" },
    { "src": "/cashier-icon-([^/]+)\\.png", "dest": "/cashier-icon-$1.png" },
    { "src": "/logo.jpg", "dest": "/logo.jpg" },
    { "src": "/logobabay.png", "dest": "/logobabay.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/media/:path*",
      "destination": "https://api.babayfood.uz/media/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/cashier-manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/cashier-sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}